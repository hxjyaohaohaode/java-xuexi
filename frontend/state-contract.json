{
  "schemaVersion": "1.1",
  "purpose": "Implemented React workspace client state boundaries plus explicit remaining design requirements; HTTP schemas remain in contracts/openapi.json",
  "frontendImplemented": true,
  "wireContract": "contracts/openapi.json",
  "scopeKey": [
    "authenticatedPrincipalScope",
    "workspaceId",
    "releaseId",
    "resourceKind",
    "resourceId"
  ],
  "stateLayers": [
    {
      "id": "serverFacts",
      "owner": "backend-domain-services",
      "clientWritePolicy": "replace-only-with-validated-authoritative-snapshot"
    },
    {
      "id": "pendingCommands",
      "owner": "client-command-coordinator",
      "clientWritePolicy": "idempotency-key-and-input-snapshot-must-survive-unknown-network-result"
    },
    {
      "id": "localDrafts",
      "owner": "learner",
      "clientWritePolicy": "server-events-never-overwrite-dirty-draft"
    },
    {
      "id": "ephemeralInteraction",
      "owner": "mounted-view",
      "clientWritePolicy": "dispose-on-unmount-and-do-not-use-as-mastery-evidence"
    },
    {
      "id": "capabilitiesAndPreferences",
      "owner": "authorized-server-configuration-and-user-preferences",
      "clientWritePolicy": "client-cannot-grant-tool-capability"
    },
    {
      "id": "transportAndVerification",
      "owner": "data-coordinator-and-server-verifier",
      "clientWritePolicy": "job-completed-is-not-content-verified"
    }
  ],
  "entityVersions": [
    {
      "schema": "Workspace",
      "idFields": [
        "id"
      ],
      "versionFields": [
        "revision",
        "eventSequence"
      ],
      "scopeFields": [
        "releaseId"
      ]
    },
    {
      "schema": "AgentRun",
      "idFields": [
        "id"
      ],
      "versionFields": [
        "runEpoch",
        "planRevision"
      ],
      "scopeFields": [
        "workspaceId"
      ],
      "releaseBinding": "Resolve fixed releaseId from the authorized Workspace; AgentRun has snapshotId and steps, not a duplicated releaseId."
    },
    {
      "schema": "Artifact",
      "idFields": [
        "id"
      ],
      "versionFields": [
        "currentRevision"
      ],
      "scopeFields": [
        "workspaceId"
      ]
    },
    {
      "schema": "ArtifactRevision",
      "idFields": [
        "artifactId"
      ],
      "versionFields": [
        "revision",
        "contentHash"
      ],
      "scopeFields": []
    },
    {
      "schema": "Attempt",
      "idFields": [
        "id"
      ],
      "versionFields": [
        "exerciseRevision"
      ],
      "scopeFields": [
        "releaseId",
        "exerciseId"
      ]
    }
  ],
  "eventStreams": {
    "run": {
      "operationId": "listRunEvents",
      "scope": "runId-from-request-path",
      "sequenceField": "sequence",
      "cursorParameter": "after",
      "payloadPolicy": "invalidation-and-refetch; RunEvent is not a complete entity snapshot",
      "onDuplicate": "ignore",
      "onGap": "resync-before-advancing-cursor",
      "onExpiredCursor": "refetch-snapshot-then-reconnect",
      "uiStatus": "Run status/steps are fetched from authoritative run snapshots; Agents displays the first 100 RunEvents as an audit view without using event payloads as business facts.",
      "uiConsumesEventStream": false,
      "uiShowsBoundedAuditEvents": true
    },
    "workspace": {
      "status": "implemented ordered polling with AbortController and workspace generation isolation",
      "checkpointField": "Workspace.eventSequence",
      "scope": "workspaceId",
      "payloadPolicy": "server-authoritative-facts-only",
      "operationId": "listWorkspaceEvents",
      "sequenceField": "sequence",
      "cursorParameter": "after",
      "onDuplicate": "ignore",
      "onGap": "resync-before-advancing-cursor",
      "resume": "in-memory cursor for a mounted workspace; a remount replays from zero in bounded pages and deduplicates"
    },
    "globalSequenceComparisonAllowed": false,
    "sseImplemented": false
  },
  "clientCommandStates": [
    "DRAFT",
    "SENDING",
    "ACKNOWLEDGED",
    "UNKNOWN",
    "REJECTED"
  ],
  "clientViewStates": [
    "LOADING",
    "READY",
    "EMPTY",
    "STALE",
    "OFFLINE",
    "FORBIDDEN",
    "NOT_CONFIGURED",
    "FAILED"
  ],
  "truthGates": {
    "http202": "accepted-not-completed",
    "networkTimeout": "unknown-not-rejected",
    "compileResult": "applies-only-to-submitted-source-hash",
    "attemptScore": "requires-GRADED-server-state",
    "infrastructureFailure": "does-not-count-as-learner-error",
    "artifactVerification": "requires-explicit-server-reviewStatus",
    "cancelRequest": "requires-server-acknowledgement",
    "generatedUi": "complete-schema-and-resource-validation-before-mount"
  },
  "optimisticPolicies": [
    {
      "operation": "theme-and-panel-preference",
      "preview": false,
      "failure": "preserve unsaved preference input; apply only after server confirmation"
    },
    {
      "operation": "artifact-edit",
      "preview": true,
      "failure": "preserve-draft-and-present-current-server-revision"
    },
    {
      "operation": "attempt-compile-run-export",
      "preview": false,
      "failure": "reconcile-with-same-idempotency-key"
    },
    {
      "operation": "pause-cancel-steer",
      "preview": false,
      "failure": "keep-pending-indicator-and-preserve-user-instruction"
    },
    {
      "operation": "memory-revocation",
      "preview": false,
      "failure": "retain last confirmed active item until server accepts revocation"
    }
  ],
  "userPriority": {
    "artifactBaseRevisionRequired": true,
    "staleAgentResultCanOverwriteUserDraft": false,
    "oldEpochCanPublishCurrentResult": false,
    "conflictResolution": [
      "compare",
      "rebase-explicitly",
      "discard-by-user-choice"
    ],
    "saveCopyImplemented": false
  },
  "generatedUi": {
    "allowArbitraryJavascript": false,
    "allowModelSelectedImports": false,
    "allowUnknownDslVersion": false,
    "partialJsonMayMountInteractiveControls": false,
    "actionsRequireServerAuthorization": true,
    "validationBoundary": "Server SchemaCatalog validates complete DSL; browser whitelists supported source kinds and renders fixed React text/controls; unknown kind/version gets unavailable state."
  },
  "accessibility": {
    "inputMethodCompositionMustBlockSubmit": true,
    "dragRequiresKeyboardAlternative": true,
    "touchRequiresHoverAlternative": true,
    "backgroundEventsMayStealFocus": false,
    "reducedMotionDisablesContinuousAnimation": true,
    "stateMustHaveTextNotOnlyColor": true,
    "privateCacheClearedOnLogout": true,
    "staleSession401MayLogOutNewSession": false,
    "staleCsrfMayReplaceNewSessionToken": false
  },
  "browserAcceptanceCases": [
    "duplicate-event-does-not-double-grade",
    "gap-enters-resync",
    "old-epoch-cannot-overwrite-current-run",
    "workspace-switch-discards-old-response",
    "retry-unknown-command-reuses-idempotency-key",
    "version-conflict-preserves-local-draft",
    "infrastructure-error-not-graded-as-wrong",
    "missing-provider-has-not-configured-state",
    "logout-clears-private-cache",
    "keyboard-touch-ime-and-reduced-motion-complete-the-same-learning-flow"
  ],
  "verification": {
    "typecheck": "PASS",
    "unitTests": "PASS: actual counts and cases in frontend/test-results/unit-report.json",
    "productionBuild": "PASS",
    "browser": "LOCAL_ENVIRONMENT_BLOCKED: Chromium AF_UNIX socket permission; browser CI remains a required gate",
    "report": "frontend/test-results/browser-report.json",
    "finalIntegrationReport": "See repository README for the current final acceptance report",
    "serviceIntegration": "PASS: real HTTP DOM, 13 linked flows; frontend/test-results/live-dom-report.json; rerun against the final JAR and record its hash in dom-runtime-report.json"
  },
  "implementationScope": {
    "routing": "hash routes; same-origin session and CSRF",
    "pages": [
      "knowledge, persistent reading receipts and search",
      "choice and code practice, hints and pending grading",
      "progress, reviews and actual learning analytics",
      "finite type lab and six code compilation labs",
      "document source and keyboard/pointer slide editor",
      "private image/audio/video asset library",
      "notebook prediction, hints, compilation and reattempts",
      "Markdown/HTML/SVG and capability-gated DOCX/PPTX/PDF exports",
      "persistent tutor",
      "durable evidence and study workflows",
      "memories and goals",
      "editorial sources, capture, revision, approval and publishing console",
      "preferences, profile, password, sessions and account closure"
    ],
    "notImplemented": [
      "untrusted arbitrary Java execution",
      "model image/audio/video generation",
      "audio/video timeline editing",
      "free multi-panel workspace layout",
      "SSE",
      "full-fidelity execution of all 209 external examples"
    ],
    "source": "frontend/src",
    "build": "npm run build",
    "unitVerification": "npm run check",
    "browserVerification": "TYPEFORGE_BASE_URL=http://127.0.0.1:8080 npm run test:e2e"
  },
  "browserAcceptanceCasesStatus": "Target checklist; only cases in actual browser-report.json count as browser-verified"
}
