{
  "name": "typeforge-workspace",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run --reporter=default --reporter=json --outputFile=test-results/unit-report.json",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "node tests/browser.mjs",
    "check": "npm run typecheck && npm run test",
    "test:live": "vitest run --config vite.live.config.ts",
    "format": "prettier --write src tests vite.config.ts vite.live.config.ts",
    "format:check": "prettier --check src tests vite.config.ts vite.live.config.ts"
  },
  "dependencies": {
    "@openmaic/dsl": "0.13.0",
    "@openmaic/renderer": "0.2.4",
    "fflate": "0.8.2",
    "lucide-react": "1.72.0",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.0.2",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
